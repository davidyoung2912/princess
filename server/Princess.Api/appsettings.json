{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost",
  "Jwt": {
    "Issuer": "princess-api",
    "Audience": "princess-web",
    "AccessTokenMinutes": 15,
    "ViewAsTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Passes": {
    "MaxLookupMisses": 5,
    "LookupLockoutMinutes": 15
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "LoginAttemptsPerMinute": 10,
    "MaxFailedLoginsPerAccount": 30,
    "MaxLockoutMinutes": 1440,
    "CodeRequestsPerHour": 3,
    "MaxCodeAttemptsPerHour": 10,
    "AllowAccountNumberLogin": false
  },
  "Providers": {
    "Weather": "sim",
    "Flight": "sim",
    "Route": "sim",
    "Telemetry": "sim",
    "StaffQueue": "sim",
    "Concierge": "sim",
    "Rates": "sim",
    "ConciergeLimit": "database",
    "StanleyLog": "database"
  },
  "Stanley": {
    "SmallModel": "claude-haiku-5-5",
    "DefaultModel": "claude-sonnet-5-5",
    "LargeModel": "claude-opus-5-5",
    "SmallMaxTokens": 300,
    "DefaultMaxTokens": 900,
    "LargeMaxTokens": 1500,
    "ChatCalls": 3,
    "PlanningCalls": 5,
    "DailyCeiling": 60,
    "Switches": { "Library": true, "Resolver": true, "Model": true, "Tools": true, "Actions": true }
  },
  "Chat": {
    "Rooms": { "ChannelsOn": true, "SailingRoomsOn": false, "InterestRoomsOn": false }
  },
  "Scheduler": {
    "IntervalMinutes": 15,
    "MaxPeople": 500
  },
  "Retention": {
    "IntervalMinutes": 360,
    "NetworkDataDays": 60,
    "StanleyDays": 180
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  }
}
