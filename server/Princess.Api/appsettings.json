{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost",
  "Jwt": {
    "Issuer": "princess-api",
    "Audience": "princess-web",
    "AccessTokenMinutes": 15,
    "ViewAsTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "LoginAttemptsPerMinute": 10
  },
  "Providers": {
    "Weather": "sim",
    "Flight": "sim",
    "Route": "sim",
    "Telemetry": "sim",
    "StaffQueue": "sim",
    "Concierge": "sim",
    "Rates": "sim",
    "ConciergeLimit": "database"
  },
  "Retention": {
    "IntervalMinutes": 360
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  }
}
