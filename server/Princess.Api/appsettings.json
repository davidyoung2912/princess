{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "princess-api",
    "Audience": "princess-web",
    "AccessTokenMinutes": 15,
    "ViewAsTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "LoginAttemptsPerMinute": 10
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  }
}
