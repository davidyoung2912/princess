<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
    <UserSecretsId>princess-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\reference-content.json" LogicalName="reference-content.json" />
    <EmbeddedResource Include="Content\ship-venues.json" LogicalName="ship-venues.json" />
    <EmbeddedResource Include="Content\ship-programmes.json" LogicalName="ship-programmes.json" />
    <EmbeddedResource Include="Content\ship-explorer.json" LogicalName="ship-explorer.json" />
    <EmbeddedResource Include="Content\port-guides.json" LogicalName="port-guides.json" />
    <EmbeddedResource Include="Content\country-guides.json" LogicalName="country-guides.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.22" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
