"finishMore.SHIP_FACTS": [{"id":"next","keywords":["next","port","going","where"],"q":"Where does the ship go next?","a":"The route and the next port are on the Itinerary screen, with arrival and all-aboard times."},{"id":"engine","keywords":["engine","tour","behind"],"q":"Is there an engine room tour?","a":"Not as a regular tour. Behind-the-scenes visits, when offered, are listed in the daily programme and need a sign-up."},{"id":"bridge","keywords":["bridge","captain","navigation"],"q":"Can I see the bridge?","a":"The bridge is not open for visits. The captain’s talks and any question times are in the daily programme."},{"id":"speed","keywords":["speed","fast","knots"],"q":"How fast does the ship go?","a":"About 21 knots at cruising speed; less when the ship is near a port."},{"id":"clock","keywords":["clock","time","zone"],"q":"Does the ship’s clock change?","a":"Yes, once on this route. Ship time and port time are shown on Home, and the Itinerary screen marks the change."},{"id":"water","keywords":["water","fresh","drink"],"q":"Where does the water come from?","a":"The ship makes its own fresh water from seawater, and tap water in cabins is safe to drink."}],
