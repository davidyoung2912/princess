"help.FAQS": [{"id":"cant-see-booking","topic":"booking","question":"I can’t see my booking","answer":"Bookings made by a travel agent or on another website do not appear until you link them. Use the booking number from your confirmation, the last name of the lead guest, and the departure date. If it still does not match, check for a typing slip in the number, then call Guest Services.","link":{"to":"/me/trips","label":"Link a booking"}},{"id":"name-mismatch","topic":"documents","question":"The name on my booking does not match my passport","answer":"A spelling fix of a few letters can be made online up to two weeks before sailing. A different name, or any change in the last two weeks, needs Guest Services, who will ask for a copy of the passport page.","link":{"to":"/me/profile","label":"Edit my details"}},{"id":"pay-balance","topic":"payment","question":"When is my final payment due, and how do I pay?","answer":"The date is on your trip page and in Payments. Pay by card there at any time before it. Receipts are kept in Payments afterwards.","link":{"to":"/me/payments","label":"Payments"}},{"id":"update-card","topic":"payment","question":"How do I change the card I pay with?","answer":"Add the new card in Payments. We keep only the last four digits and the expiry date, and you can remove a card at any time.","link":{"to":"/me/payments","label":"Payments"}},{"id":"what-documents","topic":"documents","question":"What documents do I need for this cruise?","answer":"This is a round trip from Fort Lauderdale. US citizens need proof of citizenship (a passport, or a certified birth certificate) and, if 16 or older, a photo ID. A passport is strongly recommended in case you must fly home from a port. Other citizens need a passport. Passports should be valid for six months after the return date.","link":{"to":"/me/documents","label":"Documents wallet"}},{"id":"lost-documents","topic":"documents","question":"I have lost my passport or a travel document","answer":"Call Guest Services now. If you have not yet sailed they can tell you what replacement is accepted and whether you must move to a later sailing. Do not wait until embarkation day."},{"id":"helper","topic":"account","question":"Can a family member manage my booking for me?","answer":"Yes, if you agree. Add them as a helper and choose what they may do: view, manage documents, pay, or edit details. You can remove them at any time, and everything they change appears in your history.","link":{"to":"/me/helper","label":"Family helper"}},{"id":"notifications","topic":"account","question":"How do I stop notifications?","answer":"Choose what you hear about and how in Notifications. Critical notices about itinerary changes, port closures and safety cannot be turned off, because you may need to act on them.","link":{"to":"/me/notifications","label":"Notifications"}},{"id":"text-size","topic":"account","question":"How do I make the text bigger?","answer":"Settings has text size, a high-contrast theme and reduced motion. They apply on every screen.","link":{"to":"/me/settings","label":"Settings"}},{"id":"accessibility","topic":"onboard","question":"I need accessible transport, a wheelchair or help at the port","answer":"Add your needs to your profile now, and tell Guest Services at least 14 days before sailing so equipment and assistance can be arranged. Tender ports such as Belize City need extra notice.","link":{"to":"/me/profile","label":"Edit my details"}},{"id":"cancel","topic":"booking","question":"I need to cancel or change my sailing","answer":"Changes and cancellations are handled by Guest Services so that fees and refunds are explained to you in person. Have your booking number ready."},{"id":"children","topic":"account","question":"How do my children’s accounts work?","answer":"Children sail on the booker’s booking. Their accounts are supervised: the booker manages their details, documents and payments."}],
