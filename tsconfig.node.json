{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "scripts"],
  "exclude": ["scripts/gen-content.ts", "scripts/reference-seed.ts", "scripts/gen-reference-seed.ts", "scripts/check-reference-seed.ts", "scripts/persona-seed.ts", "scripts/gen-persona-seed.ts", "scripts/check-persona-seed.ts", "scripts/ship-cabin-rows.ts", "scripts/ship-venue-data.ts", "scripts/gen-ship-venues.ts", "scripts/ship-programme-data.ts", "scripts/gen-ship-programmes.ts", "scripts/ship-explorer-data.ts", "scripts/ship-explorer-dining.ts", "scripts/ship-explorer-details.ts", "scripts/ship-explorer-spa.ts", "scripts/ship-explorer-entertainment.ts", "scripts/ship-explorer-exercise.ts", "scripts/ship-explorer-shopping.ts", "scripts/ship-explorer-activities.ts", "scripts/gen-ship-explorer.ts", "scripts/gen-catalogue-seed.ts", "scripts/check-catalogue-seed.ts"]
}
